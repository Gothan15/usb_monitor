<?xml version="1.0" encoding="utf-8"?>
<!--
  Versiones fijadas del instalador del panel.
  PanelVersion se puede sobreescribir al construir:
    wix build ... -d PanelVersion=1.2.0
  Las de PostgreSQL / Node / WinSW las usa Construir-Instalador.ps1
  para descargar siempre lo mismo (compilación reproducible).
-->
<Include>
  <?ifndef PanelVersion ?>
    <?define PanelVersion  = "1.0.0" ?>
  <?endif ?>
  <!-- Variante «completo»: 1 = el .msi lleva dentro el paquete del
       agente (paquete-agente\ y empujador\); 0 = instalador ligero
       de siempre. Construir-Instalador.ps1 lo pasa con -Completo. -->
  <?ifndef IncluirPaquete ?>
    <?define IncluirPaquete = "0" ?>
  <?endif ?>
  <?define PgVersion     = "17.5" ?>
  <?define NodeVersion   = "22.14.0" ?>
  <?define WinSwVersion  = "2.12.0" ?>
  <!-- Redis: la 7.2 es la última línea con licencia BSD-3 (la 7.4
       cambió a RSAL/SSPL), así que es la que se puede empaquetar
       dentro del instalador sin líos. Los binarios de Windows los
       publica el proyecto redis-windows/redis-windows (compilación
       MSYS2); Construir-Instalador.ps1 descarga el zip fijado y
       verifica su SHA-256. -->
  <?define RedisVersion  = "7.2.16" ?>
</Include>
