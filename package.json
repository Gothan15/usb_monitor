{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --quiet --exec \"npx tsx server.ts\" --watch server.ts --watch src --ext ts,tsx,js,jsx 2>&1",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-full": "tsx prisma/seed-full.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:force-reset": "prisma db push --force-reset",
    "user:create": "tsx scripts/createUser.ts",
    "user:list": "tsx scripts/listUsers.ts",
    "user:delete": "tsx scripts/deleteUser.ts",
    "user:rotate-key": "tsx scripts/rotateApiKey.ts",
    "user:assign-computer": "tsx scripts/assignComputer.ts",
    "computer:list": "tsx scripts/listComputers.ts",
    "test": "vitest run"
  },
