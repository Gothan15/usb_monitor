// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model USBEvent {
  id        String   @id @default(cuid())
  pcName    String
  pcIp      String
  pcUser    String
  event     String
  driveLetter    String?
  serialNumber   String?
  readonlyStatus String?
  whitelisted    Boolean  @default(false)
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("usb_events")
}

model Computer {
  id               String    @id @default(cuid())
  name             String    @unique
  ipAddress        String
  lastSeen         DateTime?
  isActive         Boolean   @default(false)
  serviceInstalled Boolean   @default(false)
  serviceRunning   Boolean   @default(false)
  lastServiceCheck DateTime?
  agentVersion     String? // versión del ejecutable/agent si se puede detectar en el futuro
  // Desbloqueo por contraseña (2FA): credencial propia del agente y modo por equipo
  agentTokenHash   String?
  agentTokenAt     DateTime?
  unlockMode       String    @default("OWNER_OR_ADMIN") // OWNER_OR_ADMIN | ADMIN_ONLY (PCs compartidas)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  users            User[] // Relación con usuarios
  pendingUnlocks   PendingUnlock[]

  @@index([lastSeen])
  @@index([ipAddress])
  @@map("computers")
}

model User {
  id               String         @id @default(cuid())
  username         String         @unique
  passwordHash     String
  apiKey           String         @unique
  role             Role           @default(USER)
  computerId       String? // Computadora asignada al usuario
  computer         Computer?      @relation(fields: [computerId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  failedAttempts   Int            @default(0)
  lockedUntil      DateTime?
  whitelistEntries USBWhitelist[]
  unlockedPendings PendingUnlock[] @relation("UnlockedBy")

  @@index([computerId])
}

enum Role {
  ADMIN @map("admin")
  USER  @map("user")
}


model USBConnection {
  id             String    @id @default(cuid())
  pcName         String
  driveLetter    String
  volumeName     String
  serialNumber   String
  model          String
  size           BigInt    @default(0)
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  lastSeen       DateTime  @default(now())
  isConnected    Boolean   @default(true)

  @@index([pcName, connectedAt])
  @@index([pcName, isConnected])
  @@index([pcName, serialNumber, isConnected])
  @@index([serialNumber])
  @@index([connectedAt])
  @@index([disconnectedAt])
  @@map("usb_connections")
}

model USBWhitelist {
  id           String   @id @default(cuid())
  serialNumber String   @unique
  label        String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("usb_whitelist")
}

// ─── Desbloqueo por contraseña (2FA) ─────────────────────────────
// Registro interno de cada inserción bloqueada que espera la contraseña
// del dueño de la PC (o del admin). NO es una aprobación: la verificación
// es automática en /api/usb-auth. Ver plan-desbloqueo-por-contrasena.
enum PendingStatus {
  BLOCKED
  UNLOCKED
  CLOSED
}

model PendingUnlock {
  id           String        @id @default(cuid())
  computerId   String?
  computer     Computer?     @relation(fields: [computerId], references: [id], onDelete: SetNull)
  pcName       String
  driveLetter  String
  serialNumber String?
  deviceLabel  String?
  whitelisted  Boolean       @default(false) // conocido o no: solo informativo
  status       PendingStatus @default(BLOCKED)
  createdAt    DateTime      @default(now())
  expiresAt    DateTime // validez del bloqueo pendiente de contraseña
  unlockedById String?
  unlockedBy   User?         @relation("UnlockedBy", fields: [unlockedById], references: [id], onDelete: SetNull)
  unlockedAt   DateTime?
  executedAt   DateTime? // cuándo el agente aplicó el desbloqueo en la PC
  closedAt     DateTime?
  closeReason  String? // REMOVED | REPLACED
  attempts     UnlockAttempt[]

  @@index([pcName, status])
  @@index([createdAt])
  @@map("pending_unlocks")
}

model UnlockAttempt {
  id            String         @id @default(cuid())
  createdAt     DateTime       @default(now())
  pendingId     String?
  pending       PendingUnlock? @relation(fields: [pendingId], references: [id], onDelete: SetNull)
  pcName        String
  usernameTried String
  userId        String?
  serialNumber  String?
  result        String // SUCCESS | BAD_PASSWORD | NOT_OWNER | NOT_WHITELISTED | NO_PENDING | LOCKED | OFFLINE_OK | OFFLINE_FAIL
  origin        String // ONLINE | OFFLINE_LOCAL

  @@index([pcName, createdAt])
  @@map("unlock_attempts")
}
