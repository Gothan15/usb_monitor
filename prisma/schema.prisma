// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model USBEvent {
  id        String   @id @default(cuid())
  pcName    String
  pcIp      String
  pcUser    String
  event     String
  driveLetter    String?
  serialNumber   String?
  readonlyStatus String?
  whitelisted    Boolean  @default(false)
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("usb_events")
}

model Computer {
  id               String    @id @default(cuid())
  name             String    @unique
  ipAddress        String
  lastSeen         DateTime?
  isActive         Boolean   @default(false)
  serviceInstalled Boolean   @default(false)
  serviceRunning   Boolean   @default(false)
  lastServiceCheck DateTime?
  agentVersion     String? // versión del ejecutable/agent si se puede detectar en el futuro
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  users            User[] // Relación con usuarios

  @@index([lastSeen])
  @@map("computers")
}

model User {
  id               String         @id @default(cuid())
  username         String         @unique
  passwordHash     String
  apiKey           String         @unique
  role             String         @default("user") // "admin" o "user"
  computerId       String? // Computadora asignada al usuario
  computer         Computer?      @relation(fields: [computerId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  failedAttempts   Int            @default(0)
  lockedUntil      DateTime?
  whitelistEntries USBWhitelist[]

  @@index([computerId])
}

model PendingUnlock {
  id          String   @id @default(cuid())
  pcName      String
  driveLetter String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  unlocked    Boolean  @default(false)

  @@index([pcName, unlocked])
  @@index([expiresAt])
  @@map("pending_unlocks")
}

model USBConnection {
  id             String    @id @default(cuid())
  pcName         String
  driveLetter    String
  volumeName     String
  serialNumber   String
  model          String
  size           BigInt    @default(0)
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  lastSeen       DateTime  @default(now())
  isConnected    Boolean   @default(true)

  @@index([pcName, isConnected])
  @@index([serialNumber])
  @@index([connectedAt])
  @@index([disconnectedAt])
  @@map("usb_connections")
}

model USBWhitelist {
  id           String   @id @default(cuid())
  serialNumber String   @unique
  label        String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("usb_whitelist")
}
