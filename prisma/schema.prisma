// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model USBEvent {
  id          String   @id @default(cuid())
  pcName      String
  pcIp        String
  pcUser      String
  event       String
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())
  
  @@map("usb_events")
  @@index([createdAt])
}

model Computer {
  id        String   @id @default(cuid())
  name      String   @unique
  ipAddress String
  lastSeen  DateTime?
  isActive  Boolean  @default(false)
  serviceInstalled Boolean @default(false)
  serviceRunning   Boolean @default(false)
  lastServiceCheck DateTime?
  agentVersion     String?  // versión del ejecutable/agent si se puede detectar en el futuro
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]   // Relación con usuarios
  
  @@map("computers")
  @@index([lastSeen])
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  apiKey       String    @unique
  role         String    @default("user") // "admin" o "user"
  computerId   String?   // Computadora asignada al usuario
  computer     Computer? @relation(fields: [computerId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  failedAttempts Int      @default(0)
  lockedUntil   DateTime?
  
  @@index([computerId])
}

model PendingUnlock {
  id          String   @id @default(cuid())
  pcName      String
  driveLetter String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  unlocked    Boolean  @default(false)
  
  @@map("pending_unlocks")
  @@index([pcName, unlocked])
  @@index([expiresAt])
}

model USBConnection {
  id            String    @id @default(cuid())
  pcName        String
  driveLetter   String
  volumeName    String
  serialNumber  String
  model         String
  size          BigInt    @default(0)
  connectedAt   DateTime  @default(now())
  disconnectedAt DateTime?
  lastSeen      DateTime  @default(now())
  isConnected   Boolean   @default(true)
  
  @@map("usb_connections")
  @@index([pcName, isConnected])
  @@index([serialNumber])
  @@index([connectedAt])
  @@index([disconnectedAt])
}
