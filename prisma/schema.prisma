// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model USBEvent {
  id        String   @id @default(cuid())
  pcName    String
  pcIp      String
  pcUser    String
  event     String
  driveLetter    String?
  serialNumber   String?
  readonlyStatus String?
  whitelisted    Boolean  @default(false)
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([createdAt])
  // La búsqueda global (/api/search) y el registro ordenan por
  // «timestamp» descendente con LIMIT: sin este índice, Postgres
  // escaneaba la tabla entera y ordenaba en cada tecla de la lupa
  // (~60 ms con 120 000 eventos); con él recorre el índice del más
  // reciente hacia atrás y se detiene en los primeros aciertos
  // (~0,1 ms medidos). Exige `npx prisma db push` al desplegar.
  @@index([timestamp])
  @@map("usb_events")
}

model Computer {
  id               String    @id @default(cuid())
  name             String    @unique
  ipAddress        String
  lastSeen         DateTime?
  isActive         Boolean   @default(false)
  serviceInstalled Boolean   @default(false)
  serviceRunning   Boolean   @default(false)
  lastServiceCheck DateTime?
  agentVersion     String? // versión del ejecutable/agent si se puede detectar en el futuro
  // Credencial del agente (overhaul 2026-11-08): par de claves
  // por equipo. El servidor guarda SOLO la clave pública (SPKI en
  // base64) y su huella; la privada nace en la PC y nunca sale.
  // Cada petición del agente va firmada (método, ruta, fecha,
  // nonce y hash del cuerpo): sin firma válida no hay
  // conversación, en ninguna ruta.
  clavePublica        String?
  clavePublicaHuella  String?
  credencialAt        DateTime?
  // Código de enrolamiento de UN SOLO USO atado a este equipo
  // (hash SHA-256; el claro se enseña una vez). Sustituye a la
  // antigua clave de flota compartida.
  codigoEnrolamientoHash   String?
  codigoEnrolamientoExpira DateTime?
  // Vigilancia de la credencial: intentos de firma fallidos y
  // última alerta (p. ej. la misma credencial vista desde dos IP).
  intentosFallidosCredencial Int       @default(0)
  alertaCredencial           String?
  credencialRevocadaAt       DateTime?
  // LEGADO DE MIGRACIÓN: hash del antiguo token por equipo. Solo
  // lo lee la ruta de migración (registrar la clave presentando
  // el token una última vez) y el puente mínimo de
  // auto-actualización; se borra en cuanto el equipo migra y la
  // columna desaparecerá cuando la flota entera haya migrado.
  agentTokenHash   String?
  unlockMode       String    @default("OWNER_OR_ADMIN") // OWNER_OR_ADMIN | ADMIN_ONLY (PCs compartidas)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  users            User[] // Relación con usuarios
  pendingUnlocks   PendingUnlock[]
  agentCommands    AgentCommand[]
  installTargets   InstallTaskTarget[]

  @@index([lastSeen])
  @@index([ipAddress])
  @@map("computers")
}

model User {
  id               String         @id @default(cuid())
  username         String         @unique
  passwordHash     String
  apiKey           String         @unique
  role             Role           @default(USER)
  computerId       String? // Computadora asignada al usuario
  computer         Computer?      @relation(fields: [computerId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  failedAttempts   Int            @default(0)
  lockedUntil      DateTime?
  sessionVersion   Int            @default(1) // Sesión única por cuenta: sube en cada login y los tokens con otra versión dejan de valer
  whitelistEntries USBWhitelist[]
  unlockedPendings PendingUnlock[] @relation("UnlockedBy")
  unlockAttempts   UnlockAttempt[]

  @@index([computerId])
}

enum Role {
  ADMIN @map("admin")
  USER  @map("user")
}


model USBConnection {
  id             String    @id @default(cuid())
  pcName         String
  driveLetter    String?
  volumeName     String
  serialNumber   String
  model          String
  deviceKind     String    @default("DISCO")
  size           BigInt    @default(0)
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  lastSeen       DateTime  @default(now())
  isConnected    Boolean   @default(true)

  @@index([pcName, connectedAt])
  @@index([pcName, isConnected])
  @@index([pcName, serialNumber, isConnected])
  @@index([serialNumber])
  @@index([connectedAt])
  @@index([disconnectedAt])
  @@map("usb_connections")
}

model USBWhitelist {
  id           String   @id @default(cuid())
  serialNumber String   @unique
  label        String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("usb_whitelist")
}

// ─── Desbloqueo por contraseña (2FA) ─────────────────────────────
// Registro interno de cada inserción bloqueada que espera la contraseña
// del dueño de la PC (o del admin). NO es una aprobación: la verificación
// es automática en /api/usb-auth. Ver plan-desbloqueo-por-contrasena.
enum PendingStatus {
  BLOCKED
  UNLOCKED
  CLOSED
}

model PendingUnlock {
  id           String        @id @default(cuid())
  computerId   String?
  computer     Computer?     @relation(fields: [computerId], references: [id], onDelete: SetNull)
  pcName       String
  driveLetter  String? // null en dispositivos sin unidad (móviles WPD, detección amplia)
  serialNumber String?
  deviceLabel  String?
  whitelisted  Boolean       @default(false) // conocido o no: solo informativo
  status       PendingStatus @default(BLOCKED)
  createdAt    DateTime      @default(now())
  expiresAt    DateTime // validez del bloqueo pendiente de contraseña
  unlockedById String?
  unlockedBy   User?         @relation("UnlockedBy", fields: [unlockedById], references: [id], onDelete: SetNull)
  unlockedAt   DateTime?
  executedAt   DateTime? // cuándo el agente aplicó el desbloqueo en la PC
  closedAt     DateTime?
  closeReason  String? // REMOVED | REPLACED
  attempts     UnlockAttempt[]

  @@index([pcName, status])
  @@index([createdAt])
  @@map("pending_unlocks")
}

model UnlockAttempt {
  id            String         @id @default(cuid())
  createdAt     DateTime       @default(now())
  pendingId     String?
  pending       PendingUnlock? @relation(fields: [pendingId], references: [id], onDelete: SetNull)
  pcName        String
  usernameTried String
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  serialNumber  String?
  result        String // SUCCESS | BAD_PASSWORD | NOT_OWNER | NOT_WHITELISTED | NO_PENDING | LOCKED | DISABLED | OFFLINE_OK | OFFLINE_FAIL
  origin        String // ONLINE | OFFLINE_LOCAL

  @@index([pcName, createdAt])
  @@map("unlock_attempts")
}

// ─── Canal de órdenes del agente (instalación remota estilo Kaspersky) ───
// Órdenes persistidas que el panel deja a un equipo y el agente recoge
// en su llamada de configuración: el panel ya no necesita credenciales
// ni puertos entrantes en el cliente, el agente conecta saliente.
// Estado: ESPERA | ENTREGADA | EN_CURSO | HECHA | ERROR.
// La primera orden es «actualizar»: el agente descarga el paquete del
// panel, verifica su SHA-256 y se sustituye a sí mismo.
model AgentCommand {
  id            String    @id @default(cuid())
  computerId    String
  computer      Computer  @relation(fields: [computerId], references: [id], onDelete: Cascade)
  type          String // actualizar
  status        String    @default("ESPERA")
  detail        String? // resultado o causa del error, según el estado
  targetVersion String? // versión que la orden «actualizar» debe dejar instalada
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now())
  deliveredAt   DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?

  @@index([computerId, status])
  @@index([createdAt])
  @@map("agent_commands")
}

// ─── Tareas de instalación (capa de Kaspersky, fase D) ────────
// Una tarea instala el agente en varios equipos a la vez. Cada
// destino va por su método: EMPUJE (SMB+RPC con el empujador,
// equipos vírgenes) o AGENTE (orden «actualizar» del canal,
// equipos que ya reportan). La contraseña de la cuenta vive SOLO
// en la memoria del servidor mientras la tarea corre: aquí se
// guarda el usuario, nunca la clave.
model InstallTask {
  id              String              @id @default(cuid())
  status          String              @default("EN_CURSO") // EN_CURSO | COMPLETADA | CON_ERRORES
  username        String // cuenta administradora de los destinos (sin su clave)
  omitIfInstalled Boolean             @default(true)
  maxAttempts     Int                 @default(2)
  createdBy       String? // admin del panel que creó la tarea
  createdAt       DateTime            @default(now())
  finishedAt      DateTime?
  targets         InstallTaskTarget[]

  @@index([createdAt])
  @@map("install_tasks")
}

model InstallTaskTarget {
  id         String      @id @default(cuid())
  taskId     String
  task       InstallTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  computerId String?
  computer   Computer?   @relation(fields: [computerId], references: [id], onDelete: SetNull)
  pcName     String
  ipAddress  String
  method     String? // EMPUJE | AGENTE (se resuelve al ejecutarse)
  status     String      @default("EN_COLA") // EN_COLA | COMPROBANDO | COPIANDO | INSTALANDO | ESPERANDO_SENAL | INSTALADO | OMITIDO | ERROR | INTERRUMPIDO
  message    String?
  detail     String?
  checks     Json? // lista de requisitos del empujador (--comprobar)
  attempts   Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([taskId, status])
  @@index([pcName])
  @@map("install_task_targets")
}

// ─── Captura de evidencia al bloquear un dispositivo no autorizado ───
// Foto del momento en que el agente bloquea un dispositivo fuera de
// la lista blanca (ajuste captureEvidenceOnNonWhitelisted, apagado
// por defecto): captura de pantalla, ventana en primer plano,
// procesos de la sesión y pestañas del navegador. Se cuelga del
// bloqueo (PendingUnlock) por id, sin relación dura: la evidencia
// puede llegar cuando el bloqueo ya cambió de estado, y borrar un
// bloqueo no debe arrastrarla sin querer.
model BlockEvidence {
  id                String   @id @default(cuid())
  pendingUnlockId   String
  computerName      String
  serialNumber      String?
  capturedAt        DateTime
  foregroundProcess String?
  foregroundTitle   String?
  processes         Json // [{ proceso, titulo? }]
  browserTabs       Json // [{ navegador, titulo, url? }]
  tabsComplete      Boolean  @default(false) // false: solo la pestaña activa de cada ventana
  nota              String? // p. ej. por qué falta la captura de pantalla
  image             Bytes?
  imageMime         String?
  createdAt         DateTime @default(now())

  @@index([pendingUnlockId])
  @@map("block_evidences")
}
