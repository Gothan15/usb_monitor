<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- Sin consola: aplicación de ventanas. El SDK Worker dejaba
         el ejecutable como aplicación de consola y al abrir la
         caja de herramientas, el asistente o el compañero quedaba
         una ventana de consola detrás (el agente Python no la
         mostraba). Como servicio da igual el subsistema, y los
         modos de consola ya vuelcan todo a agente.log. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Versión del agente: es la que el ping anuncia al panel.
         Se sube a mano con cada Release del agente. -->
    <Version>1.0.4</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Agente.Servicio-c78ab9c7-132a-4654-97f3-83d7b06e3b0b</UserSecretsId>
  <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>USBMonitorService</AssemblyName>
    <RootNamespace>USBMonitor.Agente</RootNamespace>
    <!-- Icono del ejecutable: el del proyecto, enlazado desde USBMonitor\
         (única fuente; no se duplica el binario en USBMonitorCS). -->
    <ApplicationIcon>..\..\..\USBMonitor\usb_monitor_service.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Los mismos .ico como recursos WPF: icono de cada ventana
         (el compañero usa el suyo, usb_prompt.ico). -->
    <Resource Include="..\..\..\USBMonitor\usb_monitor_service.ico" Link="usb_monitor_service.ico" />
    <Resource Include="..\..\..\USBMonitor\usb_prompt.ico" Link="usb_prompt.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agente.Core\Agente.Core.csproj" />
  </ItemGroup>
</Project>
