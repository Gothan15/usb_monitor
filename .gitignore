# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
dev.log
test
prompt

server.log

# python (las utilidades de scripts/ que aún son .py)
**/__pycache__/
*.py[cod]

seed-data.json
# SonarQube (salida del escáner, no código)
.scannerwork/

# Copias de seguridad locales y binarios generados
*.backup
*.bk2
/dist/

# Artefactos de las pruebas en el sandbox (stubs crean rutas C:/...)
/C:/

# .NET (agente C#)
agente/**/bin/
agente/**/obj/
agente/dist/

# Instalador del panel (salida de Construir-Instalador.ps1)
salida-instalador/

# Cliente Prisma 7 generado (se regenera con prisma generate)
/src/generated

# paquete de actualización del agente (lo sirve el panel en local)
/paquete-agente/*.exe
/paquete-agente/manifiesto.json

# empujador compilado junto al panel (su fuente vive en agente/empujador)
/empujador/*.exe
