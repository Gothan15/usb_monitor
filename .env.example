# ============================================================
# USB Monitor — variables de entorno (plantilla)
# Copia este archivo como ".env" en la raíz del proyecto y
# rellena los valores reales. El .env NUNCA se sube al repo.
# En producción (npm run build + npm run start) Next.js lee
# este archivo automáticamente al arrancar.
# ============================================================

# --- Base de datos (obligatoria) ---
# PostgreSQL donde vive el panel.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/usb_monitor?schema=public"

# --- Redis (rate limiting en producción) ---
# Sin esta variable el panel limita en memoria y avisa en el log
# («REDIS_URL no definido… desaconsejado en producción»): vale
# para una sola instancia, pero al reiniciar se pierden los
# contadores y no sirve si algún día hay más de un proceso.
# Con Redis local en el mismo servidor:
REDIS_URL="redis://localhost:6379"
# Con contraseña: redis://:laclave@localhost:6379
# Con un Redis en la nube (Upstash y similares), usa su URL de
# PROTOCOLO (rediss://…), NO la REST: la REST no la entiende el
# cliente y quedaría fallando en silencio sobre la memoria.

# --- Servidor ---
# Puerto del panel.
PORT=3000
# Host público con el que los agentes y navegadores llegan al
# panel (IP o nombre del servidor en la LAN). Se usa para los
# orígenes permitidos (CORS) y las URL que se generan.
APP_PUBLIC_HOST=""
# Orígenes permitidos extra, separados por comas (opcional).
# ALLOWED_ORIGINS="http://localhost:3000,https://usbmonitor.local"
# Redirigir HTTP → HTTPS en producción (por defecto sí). Pon
# "false" si el panel se sirve por HTTP dentro de la LAN.
ENFORCE_HTTPS_REDIRECT=false

# --- Sesiones (obligatoria en producción) ---
# Secreto con el que se firman las sesiones. Genera uno largo y
# aleatorio; si cambia, todas las sesiones abiertas se cierran.
SESSION_SECRET=""

# --- Agentes ---
# Puerto del servidor local del agente (5001 por defecto).
USB_SERVICE_PORT=5001
# Claves de servicio para integraciones (separadas por comas).
# SERVICE_API_KEYS=""
# Depuración del contacto de los agentes: 1 = registro detallado.
# USB_MONITOR_DEBUG=0

# --- SonarQube (análisis de código, opcional) ---
# Token de análisis de tu instancia local de SonarQube
# (http://localhost:9000). Se genera dentro de SonarQube en
# My Account → Security → Generate Tokens. El escáner lo toma
# de esta variable al lanzar el análisis. NO lo escribas en
# sonar-project.properties: ese archivo sí se sube al repo y un
# token ahí queda en el historial para siempre.
SONAR_TOKEN=""
