<?xml version="1.0" encoding="utf-8"?>
<!--
  Fuentes de paquetes del agente en C#.

  «local» es la carpeta paquetes\ junto a este archivo: si contiene
  los .nupkg del proyecto, la compilación funciona SIN internet
  (útil la primera vez, cuando la caché de NuGet está vacía y
  nuget.org no responde). Si la carpeta está vacía no pasa nada:
  NuGet usa nuget.org como siempre.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="paquetes" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
